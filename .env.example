# --- Required ---
TELEGRAM_BOT_TOKEN=123456:ABC-your-token-from-@BotFather
TELEGRAM_ALLOWED_USER_IDS=123456789          # comma separated; nobody else can talk to the bot

# --- Optional (all providers below have a usable free tier) ---
RUGCHECK_JWT=                                 # blank = anonymous 1 rps public access
HELIUS_API_KEY=                               # free: 1M credits/mo, 10 rps
BIRDEYE_API_KEY=                              # free "Standard": 30k CU/mo, 1 rps
JUPITER_API_KEY=                              # blank = lite-api.jup.ag at 1 rps

# --- Tuning ---
CACHE_DB=data/cache.sqlite
LOG_LEVEL=INFO
